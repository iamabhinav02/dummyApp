    "@shopify/flash-list": "2.2.0",
    "axios": "1.13.2",
    "moment": "2.30.1",
    "react": "19.0.0",
    "react-native": "0.78.2",
    "react-native-device-info": "15.0.1",
    "react-native-gesture-handler": "2.26.0",
    "react-native-paper": "5.14.5",
