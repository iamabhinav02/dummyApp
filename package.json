  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "pod-install": "cd ios && pod deintegrate dummyApp.xcodeproj && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install --repo-update --allow-root && cd ..",
